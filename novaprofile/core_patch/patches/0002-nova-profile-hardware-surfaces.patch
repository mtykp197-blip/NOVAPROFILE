 #include <memory>
 #include <optional>
 #include <utility>
@@ -1698,6 +1700,15 @@ int LocalDOMWindow::outerHeight() const {
     return 0;
   }
 
+  // The outer size comes from the profile; see the comment on
+  // |innerHeight()| about why the host's window size is not usable.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.viewport.outer_height > 0) {
+      return config.viewport.outer_height;
+    }
+  }
+
   LocalFrame* frame = GetFrame();
 
   // FencedFrames should return innerHeight to prevent passing
@@ -1730,6 +1741,15 @@ int LocalDOMWindow::outerWidth() const {
     return 0;
   }
 
+  // The outer size comes from the profile; see the comment on
+  // |innerHeight()| about why the host's window size is not usable.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.viewport.outer_width > 0) {
+      return config.viewport.outer_width;
+    }
+  }
+
   LocalFrame* frame = GetFrame();
 
   // FencedFrames should return innerWidth to prevent passing
@@ -1795,6 +1815,17 @@ int LocalDOMWindow::innerHeight() const {
     return 0;
   }
 
+  // The viewport is served from the profile's own configuration.  The
+  // host's viewport is the size of the window on the desktop, which is
+  // what the user resized it to -- a value that a page can read straight
+  // off and that has no relation to the device the user agent claims.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.viewport.inner_height > 0) {
+      return config.viewport.inner_height;
