diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
index 7741973..598c2f1 100644
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
@@ -4,6 +4,8 @@
 
 #include "third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.h"
 
+#include "nova_chromium_hooks.h"
+
 #include <stdint.h>
 
 #include <cmath>
@@ -1642,6 +1644,30 @@ ImageData* BaseRenderingContext2D::getImageDataInternal(
           snapshot->PaintImageForCurrentFrame().GetSkImageInfo().bounds();
       DCHECK(!bounds.intersect(SkIRect::MakeXYWH(sx, sy, sw, sh)));
     }
+
+    // The 2D canvas readback is the most heavily sampled axis.  The
+    // noise is applied to the buffer that the script receives, so the
+    // observed pixels are already perturbed and the original values
+    // cannot be recovered.  This is the single point where the readback
+    // happens, so it covers getImageData, toDataURL, toBlob and the
+    // OffscreenCanvas variants in one place.
+    if (nova::IsNovaCoreInitialized()) {
+      const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+      if (config.canvas_2d.mode != "native_passthrough" &&
+          config.canvas_2d.mode != "block") {
+        // The span is only used to reach the buffer, so the pointer and the
+        // size are taken from it directly: this translation unit does not
+        // have //base on its include path.
+        const auto bytes = image_data->RawByteSpan();
+        if (!bytes.empty() && sw > 0 && sh > 0) {
+          // The buffer is RGBA, so there are four bytes per pixel.
+          const size_t stride = static_cast<size_t>(sw) * 4;
+          nova::ApplyPixelNoise(bytes.data(), stride, sw, sh,
+                                nova::GetCanvasNoiseKey(),
+                                config.canvas_2d.noise_strength);
+        }
+      }
+    }
   }
 
   return image_data;
