+
+  // The deterministic noise is applied to the buffer that is handed back
+  // to the script, so the observed pixels are already perturbed and the
+  // original values cannot be recovered from the page.  The readback is
+  // the single most important hook in the graphics stack: a shader that
+  // renders interpolated coordinates and then reads them back is exactly
+  // the technique the anti-bot vendors use to detect a modified WebGL
+  // implementation.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.webgl.mode != "native_passthrough" &&
+        config.webgl.mode != "disabled" &&
+        config.webgl.image_noise.enabled && data && width > 0 && height > 0) {
+      nova::ApplyPixelNoise(data, static_cast<size_t>(width) * 4, width,
+                            height, nova::GetWebGLNoiseKey(),
+                            config.canvas_2d.noise_strength);
+    }
+  }
