+
 #include <inttypes.h>
 
 #include <memory>
@@ -4344,6 +4346,14 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
       return ScriptValue::CreateNull(script_state->GetIsolate());
     case WebGLDebugRendererInfo::kUnmaskedRendererWebgl:
       if (ExtensionEnabled(kWebGLDebugRendererInfoName)) {
+        // The unmasked renderer is served from the profile's own
+        // configuration.  The stock value stays as the fallback, so a
+        // context created before the configuration was loaded still
+        // reports the host's renderer.
+        const std::string nova_renderer = nova::GetUnmaskedRendererString();
+        if (!nova_renderer.empty()) {
+          return WebGLAny(script_state, String(nova_renderer));
+        }
         return WebGLAny(script_state,
                         String(ContextGL()->GetString(GL_RENDERER)));
       }
@@ -4353,6 +4363,12 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
       return ScriptValue::CreateNull(script_state->GetIsolate());
     case WebGLDebugRendererInfo::kUnmaskedVendorWebgl:
       if (ExtensionEnabled(kWebGLDebugRendererInfoName)) {
+        // The unmasked vendor is served from the profile's own
+        // configuration; see the comment above.
+        const std::string nova_vendor = nova::GetUnmaskedVendorString();
+        if (!nova_vendor.empty()) {
+          return WebGLAny(script_state, String(nova_vendor));
+        }
         return WebGLAny(script_state,
                         String(ContextGL()->GetString(GL_VENDOR)));
       }
@@ -5502,6 +5518,24 @@ void WebGLRenderingContextBase::ReadPixelsHelper(GLint x,
     }
     ContextGL()->ReadPixels(x, y, width, height, format, type, data);
   }
+
+  // The deterministic noise is applied to the buffer that is handed back
+  // to the script, so the observed pixels are already perturbed and the
+  // original values cannot be recovered from the page.  The readback is
+  // the single most important hook in the graphics stack: a shader that
+  // renders interpolated coordinates and then reads them back is exactly
+  // the technique the anti-bot vendors use to detect a modified WebGL
+  // implementation.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.webgl.mode != "native_passthrough" &&
+        config.webgl.mode != "disabled" &&
+        config.webgl.image_noise.enabled && data && width > 0 && height > 0) {
+      nova::ApplyPixelNoise(data, static_cast<size_t>(width) * 4, width,
+                            height, nova::GetWebGLNoiseKey(),
+                            config.canvas_2d.noise_strength);
+    }
+  }
 }
 
