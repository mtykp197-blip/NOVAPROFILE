diff --git a/third_party/blink/renderer/core/nova_js_layer.cc b/third_party/blink/renderer/core/nova_js_layer.cc
new file mode 100644
index 0000000000..8d96d46724
--- /dev/null
+++ b/third_party/blink/renderer/core/nova_js_layer.cc
@@ -0,0 +1,280 @@
+ï»¿// NOVA Profile Core -- the JavaScript layer, and where it runs.
+//
+// The layer itself is a document of JavaScript that the control plane
+// builds.  It is handed to the renderer over the Mojo channel and is
+// run once per document, before any script of the page.
+//
+// Where it runs
+// -------------
+//
+// The page's own first script is the trigger.  It is the earliest
+// moment at which a script may run in a document, and by then no
+// script of the page can have run yet -- so the page cannot have seen
+// the host's values.
+//
+// It cannot be earlier.  A document that is still the initial empty
+// document has no committed navigation behind it, and Blink refuses to
+// run a script in one: the frame loader forbids script execution for
+// the duration of the initial-document access check
+// (FrameLoader::DidAccessInitialDocument), and running a script from
+// inside that check takes the renderer down.  Document::Initialize()
+// is exactly where that check runs, which is why the injection used to
+// live there and why it crashed.
+//
+// A document that brings no script at all gets the layer from a
+// microtask queued on the frame's event loop.  A microtask runs at the
+// end of the current task, which is still before the page's own code --
+// a document with no script has no code to run before.
+//
+// Once per document
+// -----------------
+//
+// The layer is idempotent inside the page as well: it checks its own
+// marker before it does anything.  The set of documents that have been
+// done is here so that the layer is not run twice for a document that
+// brings both a script and a microtask.
+
+#include "third_party/blink/renderer/core/nova_js_layer.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <set>
+
+#include "base/logging.h"
+#include "base/synchronization/lock.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_binding_for_core.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/nova/nova_chromium_hooks.h"
+#include "third_party/blink/renderer/core/script/classic_script.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+#include "third_party/blink/renderer/platform/weborigin/kurl.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace nova {
+// The trace.
+//
+// The trace is a line on Chromium's own log.  That is not the obvious
+// place to put it: the log is noisy, and a trace that is switched on
+// and off is easier to live with.
+//
+// The obvious alternatives do not work.  An environment variable does
+// not reach the renderer, which is a child process, and Chromium does
+// not necessarily hand the environment to it.  A file does not work
+// either: the file stays empty.
+//
+// The log does work, because the standard error of a child process is
+// the standard error of the browser.  A line logged in the renderer
+// comes out of the browser's own standard error, next to everything
+// else.
+inline bool NovaTraceOn() {
+  return true;
+}
+
+namespace {
+
+// The documents the layer has already run in.
+//
+// The documents are kept alive by their frames for as long as they are
+// in the set, and the set is cleared when the frame navigates.
+class InjectedDocuments {
+ public:
+  static InjectedDocuments& Get() {
+    static auto* instance = new InjectedDocuments();
+    return *instance;
+  }
+
+  // Returns true when the document had not been done before.
+  bool MarkDone(const ::blink::Document* document) {
+    base::AutoLock guard(lock_);
+    return done_.insert(document).second;
+  }
+
+  void Forget(const ::blink::Document* document) {
+    base::AutoLock guard(lock_);
+    done_.erase(document);
+  }
+
+ private:
+  base::Lock lock_;
+  std::set<raw_ptr<const ::blink::Document>> done_;
+};
+
+}  // namespace
+
+// Whether the profile applies to the given document.
+//
+// The profile describes a device on the web.  Chromium's own pages --
+// the settings, the new tab page, the component extensions -- are not
+// the web, and they are part of the browser: a fingerprint that
+// changes them changes what the browser does.
+//
+// Two things go wrong without this.
+//
+// The first is visible.  A component extension that asks for the voices
+// of the speech engine goes through the extension event router, and the
+// router is null while the extension system is still coming up.  The
+// extension calls it anyway, because the page it runs in has been given
+// a fingerprint that says it is an Android phone, and the phone it
+// claims to be has a speech engine.  The browser dies with "Check
+// failed: event_router".
+//
+// The second is quieter.  The settings page measures the screen to lay
+// itself out, and the geometry perturbation moves what it measures.  A
+// fingerprint that changes the browser's own layout is a fingerprint
+// that is visible without a page.
+//
+// So the profile applies to the web and to nothing else.
+//
+// The check lives here rather than in the hooks layer because the hooks
+// layer is a standalone target: it is linked into the browser process
+// as well as into the renderer, and it deliberately does not depend on
+// Blink.  A document is a Blink thing.
+bool ProfileAppliesTo(const ::blink::Document* document) {
+  if (!document) {
+    return false;
+  }
+  const ::blink::LocalDOMWindow* window = document->domWindow();
+  if (!window) {
+    return false;
+  }
+  const ::blink::Document* current = window->document();
+  if (!current) {
+    return false;
+  }
+  // The protocol.  "chrome", "chrome-extension", "chrome-untrusted",
+  // "devtools", "chrome-search", "chrome-native", "about",
+  // "view-source" and "blob" are the browser's own.  "http" and
+  // "https" are the web.
+  //
+  // A "file" page is the web as far as the profile is concerned: it is
+  // content, not the browser, and the same rules apply to it.
+  const ::blink::KURL& url = current->Url();
+  return url.ProtocolIs("http") || url.ProtocolIs("https") ||
+         url.ProtocolIs("file");
+}
+
+bool RunProfileScript(::blink::LocalDOMWindow* window) {
+  LOG(INFO) << "NOVA: layer: run enter window=" << (window ? 1 : 0);
+  if (!window || !window->GetFrame())
+    return false;
+
+  const std::string& source = GetEffectiveJsRuntimeSource();
+  LOG(INFO) << "NOVA: layer: source len=" << (int)source.size();
+  if (source.empty())
+    return false;
+
+  // The main world is the page's own world.  A script that ran in an
+  // isolated world would patch a copy the page cannot see.
+  ::blink::ScriptState* script_state =
+      ::blink::ToScriptStateForMainWorld(window->GetFrame());
+  LOG(INFO) << "NOVA: layer: script_state=" << (script_state ? 1 : 0);
+  if (!script_state)
+    return false;
+
+  ::blink::ClassicScript* script = ::blink::ClassicScript::CreateUnspecifiedScript(
+      ::blink::String::FromUtf8(
+          base::as_byte_span(base::span<const char>(source))),
+      ::blink::ScriptSourceLocationType::kUnknown,
+      ::blink::SanitizeScriptErrors::kDoNotSanitize);
+  LOG(INFO) << "NOVA: layer: script=" << (script ? 1 : 0);
+  if (!script)
+    return false;
+
+  // The script is the profile's own, and its errors are not the page's
+  // business: a failure in it must not show up in the page's console,
+  // where a page could read it.
+  LOG(INFO) << "NOVA: layer: executing";
+  script->RunScriptOnScriptState(
+      script_state,
+      ::blink::ExecuteScriptPolicy::kExecuteScriptWhenScriptsDisabled,
+      ::blink::V8ScriptRunner::RethrowErrorsOption::DoNotRethrow());
+  LOG(INFO) << "NOVA: layer: done";
+  return true;
+}
+
+void RunProfileScriptIfPending(::blink::Document* document) {
+  LOG(INFO) << "NOVA: pending: doc=" << (document ? 1 : 0);
+  if (!document) {
+    return;
+  }
+  if (!HasJsRuntime()) {
+    LOG(INFO) << "NOVA: pending: no runtime";
+    return;
+  }
+
+  // A document that is being prerendered must not have the profile's
+  // fingerprint applied to it before it is shown.
+  //
+  // The check used to be ``!document->IsActive()``, and it was wrong.
+  // ``IsActive`` answers "is the lifecycle of this document running",
+  // and the lifecycle of a committed document stays *inactive* until
+  // the frame is focused -- and a frame in a headless browser, or a
+  // frame in a background tab, is never focused.  So the check
+  // rejected every document the layer had to run in, and the layer
+  // never ran: the page saw the host's values for every axis the
+  // layer owns.
+  //
+  // What the check was after is "is this the document the user is
+  // looking at".  That is a different question, and the layer asks it
+  // in ``ProfileAppliesTo``: the document has to be the one the window
+  // currently holds.  A prerendered document is not -- it lives in a
+  // second window until it is activated -- so that check already
+  // excludes it, and ``IsPrerendering`` excludes it a second time.
+  if (document->IsPrerendering()) {
+    LOG(INFO) << "NOVA: pending: prerendering";
+    return;
+  }
+
+  // A document that is still the initial empty document has no
+  // committed navigation behind it, and Blink refuses to run a script
+  // in one: the frame loader forbids script execution for the duration
+  // of the initial-document access check, and running a script from
+  // inside that check takes the renderer down.
+  //
+  // The layer is not run for such a document.  The initial empty
+  // document is the about:blank that precedes a navigation; it is
+  // replaced by the document the navigation commits, and the layer
+  // runs there instead.
+  if (document->IsInitialEmptyDocument()) {
+    LOG(INFO) << "NOVA: pending: initial empty document";
+    return;
+  }
+
+  // The profile describes a device on the web.  Chromium's own pages --
+  // the settings, the new tab page, the component extensions -- are not
+  // the web: they are part of the browser, and a fingerprint that
+  // changes them changes what the browser does.
+  //
+  // A component extension that asks for the voices of the speech engine
+  // goes through the extension event router, and the router is null
+  // while the extension system is still coming up.  The extension calls
+  // it anyway, because the page it runs in has been given a fingerprint
+  // that says it is an Android phone, and the phone it claims to be has
+  // a speech engine.  The browser dies with "Check failed:
+  // event_router".
+  if (!ProfileAppliesTo(document)) {
+    LOG(INFO) << "NOVA: pending: does not apply";
+    return;
+  }
+
+  // The layer is idempotent inside the page as well: it checks its own
+  // marker before it does anything.  Running it twice would be
+  // harmless but wasteful, and the second run would happen against a
+  // window whose values are already the profile's.
+  if (!InjectedDocuments::Get().MarkDone(document)) {
+    LOG(INFO) << "NOVA: pending: already done";
+    return;
+  }
+
+  ::blink::LocalDOMWindow* window = document->domWindow();
+  if (!window) {
+    LOG(INFO) << "NOVA: pending: no window";
+    return;
+  }
+
+  RunProfileScript(window);
+}
+
+}  // namespace nova
