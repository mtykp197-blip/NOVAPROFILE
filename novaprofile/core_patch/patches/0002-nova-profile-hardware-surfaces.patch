   return AdjustForAbsoluteZoom::AdjustInt(GetViewportSize().height(),
                                           GetFrame()->LayoutZoomFactor());
 }
@@ -1804,6 +1835,14 @@ int LocalDOMWindow::innerWidth() const {
     return 0;
   }
 
+  // See the comment on |innerHeight()| above.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.viewport.inner_width > 0) {
+      return config.viewport.inner_width;
+    }
+  }
+
   return AdjustForAbsoluteZoom::AdjustInt(GetViewportSize().width(),
                                           GetFrame()->LayoutZoomFactor());
 }
@@ -1814,6 +1853,14 @@ int LocalDOMWindow::screenX() const {
     return 0;
   }
 
+  // The position of the window on the host's desktop comes from the
+  // profile; a window that sits at an arbitrary position on a multi
+  // monitor desktop is a signal that the browser is not a phone.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    return config.viewport.screen_x;
+  }
+
   Page* page = frame->GetPage();
   if (!page) {
     return 0;
@@ -1839,6 +1886,12 @@ int LocalDOMWindow::screenY() const {
     return 0;
   }
 
+  // See the comment on |screenX()| above.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    return config.viewport.screen_y;
+  }
+
   Page* page = frame->GetPage();
   if (!page) {
     return 0;
@@ -1961,6 +2014,9 @@ CSSStyleDeclaration* LocalDOMWindow::getComputedStyle(
 }
 
