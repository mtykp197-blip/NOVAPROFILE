+  // often six or eight -- a number that no Android phone of the class
+  // the user agent claims has.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.audio.mode != "native_passthrough" &&
+        config.audio.mode != "disabled" && config.audio.max_channel_count > 0) {
+      return static_cast<uint32_t>(config.audio.max_channel_count);
+    }
+  }
   return GetAudioDestinationHandler().MaxChannelCount();
 }
 
