+// Returns the BoringSSL group id for the name the profile uses.
+//
+// The names in a profile are the ones the ClientHello of a Chrome release
+// carries, and BoringSSL does not expose a lookup from a name to an id.
+// The table below is therefore the mapping, and it also carries the
+// rename the hybrid key agreement went through: the draft that Chrome
+// 131 shipped was called X25519Kyber768Draft00, and the standardised
+// group is called X25519MLKEM768.  A profile that names the draft is
+// served with the group that is on the wire today, which is what the
+// release it claims to be actually sends.
+uint16_t NovaGroupId(const std::string& name) {
+  if (absl::EqualsIgnoreCase(name, "X25519") ||
+      absl::EqualsIgnoreCase(name, "x25519")) {
+    return SSL_GROUP_X25519;
+  }
+  if (absl::EqualsIgnoreCase(name, "P-256") ||
+      absl::EqualsIgnoreCase(name, "prime256v1") ||
+      absl::EqualsIgnoreCase(name, "secp256r1")) {
+    return SSL_GROUP_SECP256R1;
+  }
+  if (absl::EqualsIgnoreCase(name, "P-384") ||
+      absl::EqualsIgnoreCase(name, "secp384r1")) {
+    return SSL_GROUP_SECP384R1;
+  }
+  if (absl::EqualsIgnoreCase(name, "P-521") ||
+      absl::EqualsIgnoreCase(name, "secp521r1")) {
+    return SSL_GROUP_SECP521R1;
+  }
+  if (absl::EqualsIgnoreCase(name, "X25519Kyber768Draft00") ||
+      absl::EqualsIgnoreCase(name, "X25519MLKEM768")) {
+    return SSL_GROUP_X25519_MLKEM768;
+  }
+  if (absl::EqualsIgnoreCase(name, "MLKEM1024")) {
+    return SSL_GROUP_MLKEM1024;
+  }
+  return 0;
+}
