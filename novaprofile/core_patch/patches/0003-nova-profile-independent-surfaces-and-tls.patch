 const String& GPUAdapterInfo::vendor() const {
+  // The adapter is served from the profile's own configuration.  The
+  // host's adapter is the GPU of the machine, and the WebGPU adapter
+  // information carries the vendor, the architecture and the driver
+  // version -- a set of strings that identifies the machine far more
+  // precisely than the user agent does.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig config = nova::GetNovaConfig();
+    if (config.webgpu.enabled && !config.webgpu.adapter.vendor.empty()) {
+      static thread_local String cached_vendor;
+      cached_vendor = String::FromUtf8(config.webgpu.adapter.vendor);
+      return cached_vendor;
+    }
+  }
   return vendor_;
 }
 
