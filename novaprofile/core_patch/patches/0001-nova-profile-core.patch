diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context.cc
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context.cc
@@ -40,6 +40,8 @@
 #include "third_party/blink/renderer/modules/webgl/webgl_rendering_context.h"
+#include "nova_chromium_hooks.h"
+
 #include "third_party/blink/renderer/modules/webgl/webgl_debug_renderer_info.h"
 #include "third_party/blink/renderer/modules/webgl/webgl_extensions.h"
 #include "third_party/blink/renderer/modules/webgl/webgl_shaders.h"
@@ -620,6 +622,14 @@ void WebGLRenderingContextBase::ReadPixels(
                     GLenum format,
                     GLenum type,
                     void* pixels) {
+  // The deterministic noise is applied to the buffer that is handed back
+  // to the script, so the observed pixels are already perturbed and the
+  // original values cannot be recovered from the page.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.webgl.mode != "native_passthrough" &&
+        config.webgl.mode != "disabled" &&
+        config.webgl.image_noise.enabled) {
+      nova::ApplyPixelNoise(
+          reinterpret_cast<uint8_t*>(pixels), width * 4, width, height,
+          nova::GetWebGLNoiseKey(), config.canvas_2d.noise_strength);
+    }
+  }
   ReadPixelsImpl(0, 0, width, height, format, type, pixels);
 }
diff --git a/third_party/blink/renderer/core/canvas/canvas_rendering_context_2d.cc b/third_party/blink/renderer/core/canvas/canvas_rendering_context_2d.cc
--- a/third_party/blink/renderer/core/canvas/canvas_rendering_context_2d.cc
+++ b/third_party/blink/renderer/core/canvas/canvas_rendering_context_2d.cc
@@ -40,6 +40,8 @@
 #include "third_party/blink/renderer/core/canvas/canvas_rendering_context_2d.h"
+#include "nova_chromium_hooks.h"
+
 #include "third_party/blink/renderer/core/canvas/canvas_profile.h"
 #include "third_party/blink/renderer/core/canvas/canvas_resource_provider.h"
 #include "third_party/blink/renderer/core/html/canvas_image_data.h"
@@ -480,6 +482,15 @@ void CanvasRenderingContext2D::getImageData(
 void CanvasRenderingContext2D::getImageData(
     const CanvasImageSource* source,
     const ExceptionState& exception_state) {
+  // The 2D canvas readback is the most heavily sampled axis.  The noise
+  // is applied to the SkBitmap after the copy, which covers toDataURL,
+  // toBlob, getImageData and the OffscreenCanvas variants in one place.
+  if (nova::IsNovaCoreInitialized()) {
+    const nova::ProfileConfig& config = nova::GetNovaConfigRef();
+    if (config.canvas_2d.mode != "native_passthrough" &&
+        config.canvas_2d.mode != "block") {
+      nova::MaybeNoiseCanvasBitmap(&destination_bitmap,
+                                   config.canvas_2d.noise_strength);
+    }
+  }
 }
