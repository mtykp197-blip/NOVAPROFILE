diff --git a/content/browser/nova/nova_client_hints.cc b/content/browser/nova/nova_client_hints.cc
new file mode 100644
index 0000000000..949891c2b0
--- /dev/null
+++ b/content/browser/nova/nova_client_hints.cc
@@ -0,0 +1,175 @@
+// NOVA Profile Core -- the client hints the request carries.
+//
+// The reasoning behind this file is in nova_client_hints.h.
+
+#include "nova_client_hints.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/values.h"
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+#include "third_party/blink/renderer/core/nova/nova_core_config.h"
+
+namespace content {
+namespace {
+
+// The metadata, once it has been read.
+//
+// The profile is read once, during the startup, and the result is kept
+// here.  The client hints are attached to every request, and reading the
+// document again for each of them would mean parsing a JSON document
+// on the IO thread for the sake of every navigation -- and the IO thread
+// is not allowed to wait on the disk.
+std::optional<blink::UserAgentMetadata>& CachedMetadata() {
+  static std::optional<blink::UserAgentMetadata>* const metadata =
+      new std::optional<blink::UserAgentMetadata>();
+  return *metadata;
+}
+
+bool& MetadataLoaded() {
+  static bool* const loaded = new bool(false);
+  return *loaded;
+}
+
+// The brand list of the profile.
+//
+// The list is a list of pairs: a brand and a version.  The version is
+// the *major* version for the brand list and the *full* version for the
+// full version list, which is what the two lists are for.
+std::vector<blink::UserAgentBrandVersion> ReadBrands(
+    const base::DictValue& dict,
+    const char* key) {
+  std::vector<blink::UserAgentBrandVersion> brands;
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_list()) {
+    return brands;
+  }
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& entry = item.GetDict();
+    const base::Value* brand = entry.Find("brand");
+    const base::Value* version = entry.Find("version");
+    if (!brand || !brand->is_string() || !version || !version->is_string()) {
+      continue;
+    }
+    brands.emplace_back(brand->GetString(), version->GetString());
+  }
+  return brands;
+}
+
+// A string field, or an empty string when it is not there.
+//
+// The client hints are optional: a profile that describes a handset
+// does not always describe its bitness, and a hint that is not sent is
+// better than a hint that is wrong.
+std::string ReadStringOrEmpty(const base::DictValue& dict, const char* key) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_string()) {
+    return std::string();
+  }
+  return value->GetString();
+}
+
+bool ReadBoolOr(const base::DictValue& dict,
+                 const char* key,
+                 bool fallback) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_bool()) {
+    return fallback;
+  }
+  return value->GetBool();
+}
+
+// Reads the metadata out of the profile document.
+//
+// The document is the one the browser process read at the startup.  It
+// is parsed here, once, and the result is kept.
+void Load() {
+  if (MetadataLoaded()) {
+    return;
+  }
+  MetadataLoaded() = true;
+
+  const std::string document = nova::ReadBrowserConfigDocument();
+  if (document.empty()) {
+    return;
+  }
+
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(document, base::JSON_PARSE_RFC);
+  if (!root) {
+    LOG(ERROR) << "NOVA: the client hints could not be read: the profile "
+                  "configuration is not a JSON object";
+    return;
+  }
+
+  // The user agent data holds the brand list, the platform and the
+  // mobile flag.  It is the same block the JavaScript layer reads, so
+  // the hints on the wire and the hints the page sees come from the
+  // same place.
+  const base::Value* uad_value = root->Find("user_agent_data");
+  if (!uad_value || !uad_value->is_dict()) {
+    // Older profiles carried the block under the navigator.
+    const base::Value* navigator = root->Find("navigator");
+    if (!navigator || !navigator->is_dict()) {
+      return;
+    }
+    const base::Value* nested = navigator->GetDict().Find("user_agent_data");
+    if (!nested || !nested->is_dict()) {
+      return;
+    }
+    uad_value = nested;
+  }
+  const base::DictValue& uad = uad_value->GetDict();
+
+  blink::UserAgentMetadata metadata;
+  metadata.brand_version_list = ReadBrands(uad, "brands");
+  metadata.brand_full_version_list = ReadBrands(uad, "full_version_list");
+  metadata.platform = ReadStringOrEmpty(uad, "platform");
+  metadata.platform_version = ReadStringOrEmpty(uad, "platform_version");
+  metadata.architecture = ReadStringOrEmpty(uad, "architecture");
+  metadata.model = ReadStringOrEmpty(uad, "model");
+  metadata.bitness = ReadStringOrEmpty(uad, "bitness");
+  metadata.mobile = ReadBoolOr(uad, "mobile", false);
+  metadata.wow64 = ReadBoolOr(uad, "wow64", false);
+
+  // The full version is the version of the browser the profile claims
+  // to be.  It is not in the user agent data block -- it is the version
+  // of the browser the profile was generated for.
+  const base::Value* version_value = root->Find("browser_version");
+  if (version_value && version_value->is_dict()) {
+    metadata.full_version = ReadStringOrEmpty(version_value->GetDict(), "full");
+    if (metadata.full_version.empty()) {
+      metadata.full_version =
+          ReadStringOrEmpty(version_value->GetDict(), "version");
+    }
+  }
+
+  if (metadata.brand_version_list.empty() && metadata.platform.empty()) {
+    // The profile does not describe the client hints at all.  Chromium's
+    // own hints are then the right ones.
+    return;
+  }
+
+  CachedMetadata() = std::move(metadata);
+}
+
+}  // namespace
+
+bool HasNovaUserAgentMetadata() {
+  Load();
+  return CachedMetadata().has_value();
+}
+
+std::optional<blink::UserAgentMetadata> GetNovaUserAgentMetadata() {
+  Load();
+  return CachedMetadata();
+}
+
+}  // namespace content
diff --git a/content/browser/nova/nova_client_hints.h b/content/browser/nova/nova_client_hints.h
new file mode 100644
index 0000000000..5143b515f5
--- /dev/null
+++ b/content/browser/nova/nova_client_hints.h
@@ -0,0 +1,42 @@
+// NOVA Profile Core -- the client hints the request carries.
+//
+// The reasoning behind this file is in nova_client_hints.cc.
+
+#ifndef CONTENT_BROWSER_NOVA_NOVA_CLIENT_HINTS_H_
+#define CONTENT_BROWSER_NOVA_NOVA_CLIENT_HINTS_H_
+
+#include <optional>
+#include <string>
+
+#include "third_party/blink/public/common/user_agent/user_agent_metadata.h"
+
+namespace content {
+
+// The client hints the profile declares, for the browser process.
+//
+// A profile describes a device, and the client hints are how the device
+// describes itself to a server.  The browser's own hints describe the
+// machine it runs on -- a Windows desktop, at the version of the binary.
+//
+// A request that carries a Windows user agent next to an Android user
+// agent -- or a Windows platform next to an Android user agent -- is
+// the oldest fingerprint there is, and every detection site looks for
+// it first.  The hints have to be the profile's.
+//
+// This returns nothing when the browser was not started with a profile,
+// and the caller then leaves Chromium's own hints alone: a browser that
+// was given no profile is an ordinary browser.
+//
+// The metadata is the *user agent* half of the hints: the brand list,
+// the platform, the mobile flag, the platform version, the model, the
+// architecture and the bitness.  The other hints -- the viewport, the
+// device memory, the network quality -- belong to the machine rather
+// than to the device, and they stay as they are.
+std::optional<blink::UserAgentMetadata> GetNovaUserAgentMetadata();
+
+// Whether the profile declares its own client hints.
+bool HasNovaUserAgentMetadata();
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_NOVA_NOVA_CLIENT_HINTS_H_
diff --git a/content/browser/nova/nova_handover_cache.cc b/content/browser/nova/nova_handover_cache.cc
new file mode 100644
index 0000000000..d490eb9ca9
--- /dev/null
+++ b/content/browser/nova/nova_handover_cache.cc
@@ -0,0 +1,202 @@
+// NOVA Profile Core -- the browser-side hand-over.
+//
+// The browser process reads the profile and the JavaScript layer's
+// payload from disk and puts both on the command line of every renderer
+// it spawns.  The renderer cannot do that read itself: it is sandboxed
+// and the user data directory is not among the paths it may open.
+//
+// The catch is *where* the browser-side read happens.  The renderer
+// command line is built on the browser's IO thread, and a thread that
+// has been marked as non-blocking must not wait on the disk: a read()
+// there trips the "tls_blocking_disallowed" DCHECK and takes the whole
+// browser down.
+//
+// So the read happens exactly once, on the main thread, during startup --
+// before any renderer exists and therefore before anything a page can
+// observe.  The result is cached here, and the IO thread only ever
+// copies a string that is already in memory.
+//
+// Why this file lives in content/browser
+// --------------------------------------
+//
+// The cache is written by the startup code in content/app and read by
+// RenderProcessHostImpl, which builds the renderer's command line.  Those
+// are two different targets.
+//
+// A static library linked into both of them is linked into both of them
+// *twice*: the two copies hold two different caches, and the one that is
+// written is not the one that is read.
+//
+// That failure is silent.  The renderer simply does not receive the
+// profile, and every value it reports is the host's own -- which is
+// exactly what a site is looking for.
+//
+// content/app depends on content/browser, so the cache lives in
+// content/browser and there is one copy of it in the browser.
+//
+// The same is true of the Blink core, which holds the hooks and the
+// browser's own copy of the profile.  So this file does the whole
+// hand-over, and content/app calls exactly one function.
+
+#include "content/browser/nova/nova_handover_cache.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "third_party/blink/renderer/core/nova/nova_chromium_hooks.h"
+#include "third_party/blink/renderer/core/nova/nova_core_config.h"
+#include "third_party/blink/renderer/core/nova/nova_transport.h"
+
+namespace content {
+// The trace.
+//
+// The trace is a line on Chromium's own log.  That is not the obvious
+// place to put it: the log is noisy, and a trace that is switched on
+// and off is easier to live with.
+//
+// The obvious alternatives do not work.  An environment variable does
+// not reach the renderer, which is a child process, and Chromium does
+// not necessarily hand the environment to it.  A file does not work
+// either: the file stays empty.
+//
+// The log does work, because the standard error of a child process is
+// the standard error of the browser.  A line logged in the renderer
+// comes out of the browser's own standard error, next to everything
+// else.
+inline bool NovaTraceOn() {
+  return true;
+}
+
+
+namespace {
+
+// The cached document.  Written once on the main thread during startup
+// and only read afterwards, so a plain pointer swap is enough.
+std::string* const g_cached_config_source = new std::string();
+
+// The cached payload, encoded for the command line.
+std::string* const g_cached_js_payload = new std::string();
+
+// The payload as it was read, before any encoding.  This is what goes
+// over the Mojo channel, which has no length limit.
+std::string* const g_cached_js_payload_raw = new std::string();
+
+// Encodes a document for the command line.
+//
+// A Windows command line cannot describe a document that contains
+// quotes, spaces and newlines.  Base64 can: it has none of them, so the
+// argument survives the trip intact.
+//
+// The early-startup variant is used because this runs before the feature
+// list is registered: the ordinary encoder consults a feature flag, and
+// asking for a flag that does not exist yet is a fatal error.
+//
+// The document is deflated first.  The renderer is started with the
+// profile *and* the JavaScript layer's payload on its command line, and
+// a Windows command line holds at most 32,767 characters.  Base64 of the
+// two together is more than that, and the renderer would not start at
+// all.  Deflated the profile is a quarter of its size.
+std::string EncodeForCommandLine(const std::string& contents) {
+  const std::string deflated = nova::DeflateForCommandLine(contents);
+  if (!deflated.empty()) {
+    return base::Base64EncodeEarlyStartup(
+        base::as_byte_span(std::string_view(deflated)));
+  }
+  return base::Base64EncodeEarlyStartup(
+      base::as_byte_span(std::string_view(contents)));
+}
+
+}  // namespace
+
+void PrimeNovaHandover(const base::CommandLine& command_line) {
+  LOG(INFO) << "NOVA: prime-handover: config="
+           << (int)command_line.GetSwitchValueASCII("nova-config").size()
+           << " payload="
+           << (int)command_line.GetSwitchValueASCII("nova-js-payload").size();
+  // The profile.
+  {
+    const std::string config_path =
+        command_line.GetSwitchValueASCII("nova-config");
+    if (!config_path.empty()) {
+      base::FilePath file_path(base::FilePath::FromUTF8Unsafe(config_path));
+      std::string contents;
+      if (base::ReadFileToStringWithMaxSize(file_path, &contents,
+                                            8 * 1024 * 1024)) {
+        // The browser process installs the profile itself, and the hooks
+        // it reaches are in the Blink core -- which is a different
+        // target from this one, and a static library linked into both of
+        // them is linked into both of them twice.  So the document is
+        // handed across explicitly rather than through a shared cache.
+        nova::SetBrowserConfigDocument(contents);
+        *g_cached_config_source = EncodeForCommandLine(contents);
+        LOG(INFO) << "NOVA: config: raw=" << (int)contents.size()
+                   << " b64=" << (int)g_cached_config_source->size();
+      } else {
+        LOG(ERROR) << "NOVA: the profile configuration could not be read: "
+                   << config_path << " ("
+                   << logging::SystemErrorCodeToString(
+                          logging::GetLastSystemErrorCode())
+                   << ")";
+      }
+    }
+  }
+
+  // The JavaScript layer's payload.
+  //
+  // The payload is the profile's values, without the code that installs
+  // them.  The code is compiled into the browser, so only this part
+  // travels.
+  {
+    const std::string payload_path =
+        command_line.GetSwitchValueASCII("nova-js-payload");
+    if (!payload_path.empty()) {
+      base::FilePath file_path(base::FilePath::FromUTF8Unsafe(payload_path));
+      std::string contents;
+      if (base::ReadFileToString(file_path, &contents)) {
+        *g_cached_js_payload_raw = contents;
+        *g_cached_js_payload = EncodeForCommandLine(contents);
+      } else {
+        LOG(ERROR) << "NOVA: the JavaScript payload could not be read: "
+                   << payload_path << " ("
+                   << logging::SystemErrorCodeToString(
+                          logging::GetLastSystemErrorCode())
+                   << ")";
+      }
+    }
+  }
+
+  // The browser process installs the profile now, before any child
+  // exists and therefore before anything a page can observe.
+  //
+  // This is deliberately *not* done here.  Installing the profile means
+  // running the hooks, and the hooks touch the feature list and other
+  // parts of Chromium that are not registered yet this early in the
+  // startup -- asking for a flag that does not exist yet is a fatal
+  // error.
+  //
+  // The browser calls content::InstallNovaProfile() for that, later, from
+  // the same target and therefore with the same copy of the core.
+}
+
+void InstallNovaProfile(const base::CommandLine& command_line) {
+  nova::InitializeFromCommandLine(command_line);
+}
+
+std::string ReadNovaConfigSourceForRenderer() {
+  return *g_cached_config_source;
+}
+
+std::string ReadNovaJsPayloadForRenderer() {
+  return *g_cached_js_payload;
+}
+
+std::string ReadNovaJsPayloadRawForRenderer() {
+  return *g_cached_js_payload_raw;
+}
+
+}  // namespace content
diff --git a/content/browser/nova/nova_handover_cache.h b/content/browser/nova/nova_handover_cache.h
new file mode 100644
index 0000000000..4547635f28
--- /dev/null
+++ b/content/browser/nova/nova_handover_cache.h
@@ -0,0 +1,50 @@
+// NOVA Profile Core -- the browser-side hand-over.
+//
+// The reasoning behind this file is in nova_handover_cache.cc.
+
+#ifndef CONTENT_BROWSER_NOVA_NOVA_HANDOVER_CACHE_H_
+#define CONTENT_BROWSER_NOVA_NOVA_HANDOVER_CACHE_H_
+
+#include <string>
+
+#include "base/command_line.h"
+
+namespace content {
+
+// Reads the profile and the JavaScript layer's payload from the disk and
+// fills the hand-over cache.
+//
+// This reads the disk and therefore blocks, so it may only be called on
+// the main thread.  It must run before the first renderer is spawned.
+//
+// It also installs the profile in the browser process, before any child
+// exists and therefore before anything a page can observe.
+void PrimeNovaHandover(const base::CommandLine& command_line);
+
+// Installs the profile in the browser process.
+//
+// This runs the hooks, which touch the feature list and other parts of
+// Chromium that are not registered this early in the startup.  So it
+// runs later than the hand-over, and from the same target -- and
+// therefore with the same copy of the core -- as the hand-over.
+void InstallNovaProfile(const base::CommandLine& command_line);
+
+// The cached profile, for the renderer's command line.
+//
+// The IO thread calls this; it never touches the disk.  An empty result
+// means the browser was not started with a profile it could read.
+std::string ReadNovaConfigSourceForRenderer();
+
+// The cached payload, encoded for the command line.
+//
+// An empty result means there is none.
+std::string ReadNovaJsPayloadForRenderer();
+
+// The cached payload as it was read, before any encoding.
+//
+// This is what goes over the Mojo channel, which has no length limit.
+std::string ReadNovaJsPayloadRawForRenderer();
+
