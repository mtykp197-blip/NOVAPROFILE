+// ---------------------------------------------------------------------------
+// The font inventory
+// ---------------------------------------------------------------------------
+
+bool IsFontInProfile(const std::string& family_name,
+                     const std::vector<std::string>& installed) {
+  // The generic families are always available: the CSS font matching
+  // resolves them to whatever the platform offers, and a page that asks
+  // for "sans-serif" is asking for a family, not for a file.
+  static const char* kGenericFamilies[] = {
+      "serif",      "sans-serif", "monospace",   "cursive",
+      "fantasy",    "system-ui",  "ui-serif",   "ui-sans-serif",
+      "ui-monospace", "ui-rounded", "math",       "emoji",
+      "fangsong",
+  };
+  for (const char* generic : kGenericFamilies) {
+    if (base::EqualsCaseInsensitiveASCII(family_name, generic)) {
+      return true;
+    }
+  }
+
+  // The comparison is case insensitive, because the CSS font matching is
+  // case insensitive for the family names.
+  for (const std::string& candidate : installed) {
+    if (base::EqualsCaseInsensitiveASCII(candidate, family_name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// The geometry perturbation
+//
+// The perturbation is applied only when the profile asked for it.  A
+// profile in the "noise" mode gets the deltas of its own seed; a profile
+// in the "disabled" mode gets the rectangle the layout produced, so the
+// page sees the host geometry untouched.
+// ---------------------------------------------------------------------------
+
+void ApplyRectDeltas(gfx::RectF& rect, const char* surface) {
+  if (!IsNovaCoreInitialized()) {
+    return;
+  }
+  const ProfileConfig config = GetNovaConfig();
+  if (config.rects.mode == "disabled" || config.rects.mode == "native_passthrough") {
+    return;
+  }
+  const int delta_x = GetRectDeltaX();
+  const int delta_y = GetRectDeltaY();
+  const int delta_width = GetRectDeltaWidth();
+  const int delta_height = GetRectDeltaHeight();
+  if (delta_x == 0 && delta_y == 0 && delta_width == 0 && delta_height == 0) {
+    return;
+  }
+  // The surface name keeps the element rectangle and the range rectangle
+  // from moving by exactly the same amount.  A page that compares the
+  // two -- a classic cross-surface consistency check -- must not find
+  // them trivially equal.
+  int surface_shift = 0;
+  if (surface != nullptr) {
+    for (const char* c = surface; *c != '\0'; ++c) {
+      surface_shift = (surface_shift * 31 + static_cast<unsigned char>(*c)) & 0xFF;
+    }
+  }
+  const int shift_x = (surface_shift % 3) - 1;
+  const int shift_y = ((surface_shift >> 3) % 3) - 1;
+
+  rect.Offset(delta_x * (1 + shift_x) * 0.5f, delta_y * (1 + shift_y) * 0.5f);
+  if (delta_width != 0 || delta_height != 0) {
+    rect.set_width(std::max(0.0f, rect.width() + delta_width));
+    rect.set_height(std::max(0.0f, rect.height() + delta_height));
+  }
+}
+
+// ---------------------------------------------------------------------------
+// The TLS handshake
+//
+// The lists are returned by value through a function-local static, so
+// that the caller can hold on to the reference.  The configuration is
+// read once and then never changes, so the copy is made once.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+// The lists are returned through a function-local static, so that the
+// caller can hold on to the reference.  The configuration is read once
+// and then never changes, so the copy is made once.
+template <typename Reader>
+const std::vector<std::string>& TlsList(Reader reader) {
+  static const std::vector<std::string> kEmpty;
+  static thread_local std::vector<std::string> cached;
+  if (!IsNovaCoreInitialized()) {
+    return kEmpty;
+  }
+  const ProfileConfig config = GetNovaConfig();
+  cached = reader(config);
+  return cached;
+}
+
+}  // namespace
+
+const std::vector<std::string>& GetTlsCipherSuites() {
+  return TlsList(
+      [](const ProfileConfig& c) { return c.tls.cipher_suites; });
+}
+
+const std::vector<std::string>& GetTlsSupportedGroups() {
+  return TlsList(
+      [](const ProfileConfig& c) { return c.tls.supported_groups; });
+}
+
+const std::vector<std::string>& GetTlsSignatureAlgorithms() {
+  return TlsList(
+      [](const ProfileConfig& c) { return c.tls.signature_algorithms; });
+}
+
+const std::vector<std::string>& GetTlsAlpnProtocols() {
+  return TlsList(
+      [](const ProfileConfig& c) { return c.tls.alpn_protocols; });
+}
+
+const std::vector<std::string>& GetTlsVersions() {
+  return TlsList([](const ProfileConfig& c) { return c.tls.versions; });
+}
+
+const std::vector<std::string>& GetTlsExtensionOrder() {
+  return TlsList(
+      [](const ProfileConfig& c) { return c.tls.extension_order; });
+}
+
+bool GetTlsGreaseEnabled() {
+  if (!IsNovaCoreInitialized()) {
+    return true;
+  }
+  return GetNovaConfig().tls.grease_enabled;
+}
+
+}  // namespace nova
diff --git a/third_party/blink/renderer/core/nova/nova_chromium_hooks.h b/third_party/blink/renderer/core/nova/nova_chromium_hooks.h
new file mode 100644
index 0000000000..4616dfc 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/nova/nova_chromium_hooks.h
@@ -0,0 +1,216 @@
+// NOVA Profile Core -- the Chromium integration patches.
+//
+// This header is included by the Chromium source files that need to serve
+// the spoofed values.  It is deliberately tiny: a single inline function
+// per patched accessor, so the diff against the Chromium tree stays
+// reviewable.
+//
+//   third_party/blink/renderer/core/events/navigator_events.cc
+//   third_party/blink/renderer/core/execution_context/navigator_base.cc
+//   third_party/blink/renderer/core/frame/navigator.cc
+//   third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+//   third_party/blink/renderer/core/frame/navigator_device_memory.cc
+//   third_party/blink/renderer/core/frame/navigator_id.cc
+//   third_party/blink/renderer/core/frame/navigator_language.cc
+//   third_party/blink/renderer/core/frame/navigator_ua.cc
+//   third_party/blink/renderer/core/frame/navigator_ua_data.cc
+//   third_party/blink/renderer/core/frame/screen.cc
+//   third_party/blink/renderer/core/frame/local_dom_window.cc
+//   third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+//   third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+//   content/public/browser/content_main_runner.cc
+//
+// The hooks layer itself lives in
+//
+//   third_party/blink/renderer/core/nova/nova_core_config.{h,cc}
+//   third_party/blink/renderer/core/nova/nova_pixel_noise.{h,cc}
+//   third_party/blink/renderer/core/nova/nova_blink_patch.cc
+//
+// and is built as the target
+// ``//third_party/blink/renderer/core/nova:nova_core``.
+
+#ifndef NOVA_PROFILE_CORE_CHROMIUM_HOOKS_H_
+#define NOVA_PROFILE_CORE_CHROMIUM_HOOKS_H_
+
+#include "nova_core_config.h"
+#include "nova_pixel_noise.h"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace nova {
+
+// ---------------------------------------------------------------------------
+// The configuration accessor.
+//
+// The config is held in the browser process and replicated into the
+// renderer, the GPU process and the network service through a Mojo
+// shared-memory region.  Every process therefore reports exactly the
+// same values, which is what makes a cross-context check succeed.
+// ---------------------------------------------------------------------------
+
+bool IsNovaCoreInitialized();
+ProfileConfig GetNovaConfig();
+
+// The same configuration without the copy.  Use this on the hot paths:
+// the client hints are read on every request.
+const ProfileConfig& GetNovaConfigRef();
+
+// The noise keys, one per readback surface.
+PixelNoiseKey GetCanvasNoiseKey();
+PixelNoiseKey GetWebGLNoiseKey();
+PixelNoiseKey GetOffscreenNoiseKey();
+
+// The WebGL identity strings.
+std::string GetUnmaskedVendorString();
+std::string GetUnmaskedRendererString();
+
+// ---------------------------------------------------------------------------
+// The surfaces that are read on their own.
+//
+// A fingerprinting script does not have to combine the canvas hash with
+// the WebGL hash with the device serial.  It can read the audio
+// fingerprint, the geometry of a rectangle, the media device list, the
+// motion readings or the storage estimate and cluster on any one of them
+// alone.  Each of those therefore needs its own accessor, and each of
+// them is derived from the profile's own seed so that two profiles never
+// report the same value.
+// ---------------------------------------------------------------------------
+
+// The audio fingerprint.
+//
+// The Web Audio API produces a device-specific fingerprint from the
+// combination of an oscillator and a compressor.  The accessors return
+// the profile's own sample rate, latency and channel count, and the
+// renderer applies the deterministic perturbation to the rendered
+// samples.
+double GetAudioSampleRate();
+double GetAudioBaseLatency();
+double GetAudioOutputLatency();
+int GetAudioChannelCount();
+int GetAudioMaxChannelCount();
+PixelNoiseKey GetAudioNoiseKey();
+
+// Applies the profile's own perturbation to a block of rendered samples.
+// The Web Audio fingerprint is the sum of an oscillator and a
+// compressor, and the result is stable to about fifteen digits on every
+// machine that runs the same build.  Two profiles that render the same
+// graph therefore produce the same fingerprint unless the samples
+// themselves are perturbed.
+//
+// The perturbation is deterministic in the sample index and in the
+// profile's own salt, so the fingerprint of one profile never changes
+// between two reads, and the fingerprint of two profiles never collides.
+void ApplyAudioNoise(float* samples, size_t count, size_t offset);
+
+// The geometry perturbation.
+//
+// The deltas are applied as integer pixel offsets, so the layout and the
+// hit testing stay consistent with what the page sees.
+int GetRectDeltaX();
+int GetRectDeltaY();
+int GetRectDeltaWidth();
+int GetRectDeltaHeight();
+
+// Applies the profile's own deltas to a rectangle.  The |surface| names
+// the readback surface, so that the element rectangle and the range
+// rectangle are perturbed by different amounts and therefore still look
+// like two independent observations of the same layout.
+void ApplyRectDeltas(gfx::RectF& rect, const char* surface);
+
+// The media devices.
+//
+// The device identifiers are derived from the profile's own salt, so two
+// profiles never expose the same device ids.
+std::string GetMediaDeviceSalt();
+
+// Rewrites a device identifier so that it is unique to the profile.  The
+// host's identifiers are stable across every profile that runs on the
+// machine, which makes them a very effective way to link two profiles
+// that are supposed to be two different devices.  The rewrite keeps the
+// shape of the identifier -- an Android camera id looks like a UUID --
+// so that a page which validates the format does not reject it.
+//
+// |kind| names the device class ("audioinput", "audiooutput",
+// "videoinput") and |index| is the position of the device in the host's
+// list.  The pair, mixed with the profile's salt, produces the new
+// identifier.
+std::string RewriteMediaDeviceId(const std::string& device_id,
+                                 const char* kind,
+                                 size_t index);
+
+// The motion sensors.
+double GetSensorAccelerometerX();
+double GetSensorAccelerometerY();
+double GetSensorAccelerometerZ();
+double GetSensorGyroscopeX();
+double GetSensorGyroscopeY();
+double GetSensorGyroscopeZ();
+double GetSensorGravityZ();
+
+// The per-unit salts of the motion and the storage surfaces.  The core
+// mixes them into the readings it hands out, so that two units of the
+// same model do not report the same gravity or the same storage
+// estimate -- the raw readings alone cannot tell them apart.
+std::string GetSensorSalt();
+std::string GetStorageSalt();
+
+// The storage estimate.
+uint64_t GetStorageQuotaBytes();
+uint64_t GetStorageUsageBytes();
+
+// The WebGPU adapter.
+std::string GetWebGpuSalt();
+
+// Whether a font family is one of the families the profile declares as
+// installed.  The comparison is case insensitive, because the CSS font
+// matching is, and the generic families -- serif, sans-serif, monospace
+// and the cursive ones -- are always available.
+bool IsFontInProfile(const std::string& family_name,
+                     const std::vector<std::string>& installed);
+
+// The process entry points.
+bool InitializeFromCommandLine(const base::CommandLine& command_line);
+bool InitializeGpuProcess(const base::CommandLine& command_line);
+bool InitializeNetworkProcess(const base::CommandLine& command_line);
+
+// ---------------------------------------------------------------------------
+// The TLS handshake.
+//
+// The network service runs in its own process, so it has to be able to
+// read the configuration on its own.  The profile is installed there
+// from the command line the same way it is in the browser.
+// ---------------------------------------------------------------------------
+
+// The cipher suites the client offers, in the order it offers them.
+// An empty list means the stock Chromium list.
+const std::vector<std::string>& GetTlsCipherSuites();
+
+// The supported groups the client offers, in the order it offers them.
+const std::vector<std::string>& GetTlsSupportedGroups();
+
+// The signature algorithms the client offers, in the order it offers
+// them.
+const std::vector<std::string>& GetTlsSignatureAlgorithms();
+
+// The ALPN protocols the client offers, in the order it offers them.
+const std::vector<std::string>& GetTlsAlpnProtocols();
+
+// The TLS versions the client offers, from the oldest to the newest.
+const std::vector<std::string>& GetTlsVersions();
+
+// The extension order.  BoringSSL permutes the extensions by default;
+// the profile fixes the order so that the handshake of two profiles can
+// be told apart.
+const std::vector<std::string>& GetTlsExtensionOrder();
+
+// Whether the handshake carries the GREASE extension.
+bool GetTlsGreaseEnabled();
+
+}  // namespace nova
+
+#endif  // NOVA_PROFILE_CORE_CHROMIUM_HOOKS_H_
diff --git a/third_party/blink/renderer/core/nova/nova_core_config.cc b/third_party/blink/renderer/core/nova/nova_core_config.cc
new file mode 100644
index 0000000000..0187da0 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/nova/nova_core_config.cc
@@ -0,0 +1,1098 @@
+// NOVA Profile Core -- configuration parsing (implementation).
+
+#include "nova_core_config.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace nova {
+namespace {
+
+// Small helpers for reading a JSON value into a typed field.  Each helper
+// returns false when the key is missing or has the wrong shape, which makes
+// the parser strict: a profile that is missing a field is rejected rather
+// than silently half-applied.
+
+bool ReadString(const base::DictValue& dict,
+                const char* key,
+                std::string* out,
+                std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_string()) {
+    *error = std::string("missing or non-string field: ") + key;
+    return false;
+  }
+  *out = value->GetString();
+  return true;
+}
+
+// A missing or misshaped field leaves |out| alone, so the caller seeds it
+// with the value it wants to fall back to.  The signature matches the
+// strict readers above.
+bool ReadStringOrDefault(const base::DictValue& dict,
+                          const char* key,
+                          std::string* out,
+                          std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_string()) {
+    *error = std::string("non-string field: ") + key;
+    return false;
+  }
+  *out = value->GetString();
+  return true;
+}
+
+bool ReadInt(const base::DictValue& dict,
+             const char* key,
+             int* out,
+             std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_int()) {
+    *error = std::string("missing or non-integer field: ") + key;
+    return false;
+  }
+  *out = value->GetInt();
+  return true;
+}
+
+// The seed epoch and the nudge step are unsigned, so they need their own
+// overload: an ``int*`` cannot bind to a ``uint32_t*``.
+bool ReadInt(const base::DictValue& dict,
+             const char* key,
+             uint32_t* out,
+             std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_int()) {
+    *error = std::string("missing or non-integer field: ") + key;
+    return false;
+  }
+  *out = static_cast<uint32_t>(value->GetInt());
+  return true;
+}
+
+bool ReadIntOrDefault(const base::DictValue& dict,
+                       const char* key,
+                       int* out,
+                       std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_int()) {
+    *error = std::string("non-integer field: ") + key;
+    return false;
+  }
+  *out = value->GetInt();
+  return true;
+}
+
+bool ReadDouble(const base::DictValue& dict,
+                const char* key,
+                double* out,
+                std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_double() && !value->is_int()) {
+    *error = std::string("missing or non-numeric field: ") + key;
+    return false;
+  }
+  *out = value->GetDouble();
+  return true;
+}
+
+bool ReadBool(const base::DictValue& dict,
+              const char* key,
+              bool* out,
+              std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_bool()) {
+    *error = std::string("missing or non-boolean field: ") + key;
+    return false;
+  }
+  *out = value->GetBool();
+  return true;
+}
+
+bool ReadBoolOrDefault(const base::DictValue& dict,
+                       const char* key,
+                       bool* out,
+                       std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value) {
+    return true;
+  }
+  if (!value->is_bool()) {
+    *error = std::string("non-boolean field: ") + key;
+    return false;
+  }
+  *out = value->GetBool();
+  return true;
+}
+
+bool ReadStringList(const base::DictValue& dict,
+                    const char* key,
+                    std::vector<std::string>* out,
+                    std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_list()) {
+    *error = std::string("missing or non-list field: ") + key;
+    return false;
+  }
+  out->clear();
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_string()) {
+      *error = std::string("non-string item in list field: ") + key;
+      return false;
+    }
+    out->push_back(item.GetString());
+  }
+  return true;
+}
+
+bool ReadIntList(const base::DictValue& dict,
+                 const char* key,
+                 std::vector<int>* out,
+                 std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_list()) {
+    *error = std::string("missing or non-list field: ") + key;
+    return false;
+  }
+  out->clear();
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_int()) {
+      *error = std::string("non-integer item in list field: ") + key;
+      return false;
+    }
+    out->push_back(item.GetInt());
+  }
+  return true;
+}
+
+bool ReadDoubleList(const base::DictValue& dict,
+                     const char* key,
+                     std::vector<double>* out,
+                     std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_list()) {
+    *error = std::string("missing or non-list field: ") + key;
+    return false;
+  }
+  out->clear();
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_double() && !item.is_int()) {
+      *error = std::string("non-numeric item in list field: ") + key;
+      return false;
+    }
+    out->push_back(item.GetDouble());
+  }
+  return true;
+}
+
+const base::DictValue* FindDict(const base::DictValue& parent,
+                                   const char* key,
+                                   std::string* error) {
+  const base::Value* value = parent.Find(key);
+  if (!value || !value->is_dict()) {
+    *error = std::string("missing or non-object field: ") + key;
+    return nullptr;
+  }
+  return &value->GetDict();
+}
+
+bool ReadStringMap(const base::DictValue& dict,
+                   const char* key,
+                   std::map<std::string, std::string>* out,
+                   std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_dict()) {
+    *error = std::string("missing or non-object field: ") + key;
+    return false;
+  }
+  out->clear();
+  for (const auto& pair : value->GetDict()) {
+    if (!pair.second.is_string()) {
+      *error = std::string("non-string value in map field: ") + key;
+      return false;
+    }
+    out->emplace(pair.first, pair.second.GetString());
+  }
+  return true;
+}
+
+bool ReadDoubleMap(const base::DictValue& dict,
+                   const char* key,
+                   std::map<std::string, double>* out,
+                   std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_dict()) {
+    *error = std::string("missing or non-object field: ") + key;
+    return false;
+  }
+  out->clear();
+  for (const auto& pair : value->GetDict()) {
+    if (!pair.second.is_double() && !pair.second.is_int()) {
+      *error = std::string("non-numeric value in map field: ") + key;
+      return false;
+    }
+    out->emplace(pair.first, pair.second.GetDouble());
+  }
+  return true;
+}
+
+// Reads a vector of {brand, version} objects.
+bool ReadBrandList(const base::DictValue& dict,
+                   const char* key,
+                   std::vector<BrandVersion>* out,
+                   std::string* error) {
+  const base::Value* value = dict.Find(key);
+  if (!value || !value->is_list()) {
+    *error = std::string("missing or non-list field: ") + key;
+    return false;
+  }
+  out->clear();
+  for (const base::Value& item : value->GetList()) {
+    if (!item.is_dict()) {
+      *error = std::string("non-object item in list field: ") + key;
+      return false;
+    }
+    BrandVersion brand;
+    if (!ReadString(item.GetDict(), "brand", &brand.brand, error) ||
+        !ReadString(item.GetDict(), "version", &brand.version, error)) {
+      return false;
+    }
+    out->push_back(brand);
+  }
+  return true;
+}
+
+bool ReadShaderPrecision(const base::DictValue& dict,
+                         ShaderPrecision* out,
+                         std::string* error) {
+  const base::DictValue* vertex = FindDict(dict, "vertex_shader", error);
+  if (!vertex) return false;
+  const base::DictValue* fragment = FindDict(dict, "fragment_shader", error);
+  if (!fragment) return false;
+
+  auto read_stage = [&](const base::DictValue& stage,
+                         std::map<std::string, ShaderPrecisionRange>* target) {
+    for (const auto& pair : stage) {
+      if (!pair.second.is_dict()) {
+        *error = "non-object entry in a shader precision table";
+        return false;
+      }
+      ShaderPrecisionRange range;
+      if (!ReadInt(pair.second.GetDict(), "range_min", &range.range_min, error) ||
+          !ReadInt(pair.second.GetDict(), "range_max", &range.range_max, error) ||
+          !ReadInt(pair.second.GetDict(), "precision", &range.precision, error)) {
+        return false;
+      }
+      target->emplace(pair.first, range);
+    }
+    return true;
+  };
+
+  return read_stage(*vertex, &out->vertex_shader) &&
+         read_stage(*fragment, &out->fragment_shader);
+}
+
+// ---------------------------------------------------------------------------
+// Section parsers
+// ---------------------------------------------------------------------------
+
+bool ParseSeed(const base::DictValue& dict, SeedConfig* out, std::string* error) {
+  return ReadString(dict, "master_seed", &out->master_seed, error) &&
+         ReadInt(dict, "seed_epoch", &out->seed_epoch, error) &&
+         ReadInt(dict, "nudge_step", &out->nudge_step, error) &&
+         ReadString(dict, "hkdf_version", &out->hkdf_version, error) &&
+         ReadString(dict, "preset_id", &out->preset_id, error) &&
