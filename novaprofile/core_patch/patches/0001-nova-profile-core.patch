+//
+// and is built as the target
+// ``//third_party/blink/renderer/core/nova:nova_core``.
+
+#ifndef NOVA_PROFILE_CORE_CHROMIUM_HOOKS_H_
+#define NOVA_PROFILE_CORE_CHROMIUM_HOOKS_H_
