 const Vector<String>& NavigatorLanguage::languages() {
+  if (nova::IsNovaCoreInitialized()) {
+    // The accessor returns a reference, so the substituted list is kept
+    // in a process-wide cache.  The profile configuration is installed
+    // once, before any renderer exists, and is never replaced afterwards,
+    // so the reference stays valid for the lifetime of the process.
+    static const base::NoDestructor<Vector<String>> nova_languages([] {
+      Vector<String> list;
+      for (const std::string& language :
+           nova::GetNovaConfig().navigator.languages) {
+        list.push_back(String::FromUtf8(language));
+      }
+      return list;
+    }());
+    return *nova_languages;
+  }
   EnsureUpdatedLanguage();
   return languages_;
 }
