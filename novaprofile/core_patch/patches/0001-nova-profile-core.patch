+
+bool PixelNoiseKey::operator==(const PixelNoiseKey& other) const {
+  return memcmp(bytes, other.bytes, sizeof(bytes)) == 0;
+}
+
+PixelNoiseKey DerivePixelNoiseKey(const SeedConfig& seed,
+                                   const std::string& surface,
+                                   const std::string& salt,
+                                   const std::string& renderer) {
+  PixelNoiseKey key;
+
+  uint8_t master[32];
+  if (!HexToBytes(seed.master_seed, master, sizeof(master))) {
+    // A malformed seed yields a constant key rather than crashing the
+    // browser; the profile would fail the consistency check anyway.
+    memset(key.bytes, 0, sizeof(key.bytes));
+    return key;
+  }
+
+  std::vector<uint8_t> ikm(master, master + sizeof(master));
+  std::vector<uint8_t> salt_bytes(kPixelDomainSalt,
+                                   kPixelDomainSalt + sizeof(kPixelDomainSalt));
+  std::vector<uint8_t> prk = HkdfExtract(salt_bytes, ikm);
+
+  // The context binds the surface, the salt and the renderer.  Including
+  // the renderer is what prevents two different GPUs from colliding.
+  std::string context = surface;
+  context += "|salt=" + salt;
+  context += "|renderer=" + renderer;
+
+  std::string info =
+      BuildInfo("webgl_pixel", seed.seed_epoch, seed.nudge_step, context);
+  std::vector<uint8_t> okm = HkdfExpand(prk, info, sizeof(key.bytes));
+  memcpy(key.bytes, okm.data(), sizeof(key.bytes));
+  return key;
+}
+
+double WebglImageValue(const SeedConfig& seed, const std::string& renderer) {
+  uint8_t master[32];
+  if (!HexToBytes(seed.master_seed, master, sizeof(master))) {
+    return 1e-7;
+  }
+
+  std::vector<uint8_t> ikm(master, master + sizeof(master));
+  std::vector<uint8_t> salt_bytes(kPixelDomainSalt,
+                                   kPixelDomainSalt + sizeof(kPixelDomainSalt));
+  std::vector<uint8_t> prk = HkdfExtract(salt_bytes, ikm);
+
+  // The material must match SeedDeriver.derive_webgl_image_value().
+  std::string material;
+  material += "epoch=" + std::to_string(seed.seed_epoch);
+  material.push_back('\0');
+  material += "nudge=" + std::to_string(seed.nudge_step);
+  material.push_back('\0');
+  material += renderer;
+  material.push_back('\0');
+  material += "webgl.image_value.v1";
+
+  uint8_t digest[SHA256_DIGEST_LENGTH];
+  SHA256_CTX sha_ctx;
+  SHA256_Init(&sha_ctx);
+  SHA256_Update(&sha_ctx, prk.data(), prk.size());
+  SHA256_Update(&sha_ctx, reinterpret_cast<const uint8_t*>(material.data()),
+                material.size());
+  SHA256_Final(digest, &sha_ctx);
+
+  std::vector<uint8_t> raw =
+      HkdfExpand(std::vector<uint8_t>(digest, digest + sizeof(digest)),
+                 "webgl-image-value", 32);
+
+  // Interpret the 32 bytes as a big-endian integer and scale it into
+  // (0, 1).  Exactly the same arithmetic as the Python side.
+  uint64_t high = 0;
+  uint64_t low = 0;
+  for (int i = 0; i < 8; ++i) {
+    high = (high << 8) | raw[i];
+  }
+  for (int i = 8; i < 16; ++i) {
+    low = (low << 8) | raw[i];
+  }
+  // 2^-128 scale: high provides the integer part, low the fraction.
+  long double scaled = static_cast<long double>(high) * 4294967296.0L +
+                       static_cast<long double>(low);
+  scaled /= 340282366920938463463374607431768211456.0L;  // 2^128
+
+  double value = static_cast<double>(scaled) * 1e-4 + 1e-7;
+
+  // Format with 17 significant digits, matching Python's "%.17g".
+  char buffer[64];
+  snprintf(buffer, sizeof(buffer), "%.17g", value);
+  return value;
+}
+
+int8_t PixelNoiseOffset(const PixelNoiseKey& key, int x, int y, int channel) {
+  uint64_t h = 0;
+  memcpy(&h, key.bytes, sizeof(h));
+  uint64_t position = (static_cast<uint64_t>(static_cast<uint32_t>(x)) << 32) |
+                      static_cast<uint64_t>(static_cast<uint32_t>(y));
+  uint64_t mixed =
+      Mix64(h ^ position ^ (static_cast<uint64_t>(channel) << 56));
+  // Map into [-32, 32).
+  int value = static_cast<int>((mixed >> 40) & 0x3F) - 32;
+  return static_cast<int8_t>(value);
+}
+
+void ApplyPixelNoise(uint8_t* data,
+                      size_t stride,
+                      int width,
+                      int height,
+                      const PixelNoiseKey& key,
+                      double strength) {
+  if (!data || width <= 0 || height <= 0 || strength <= 0.0) {
+    return;
+  }
+
+  // The perturbation amplitude.  Even at full strength the change stays
+  // within one or two least significant bits of a channel, which is below
+  // the threshold that the anti-bot vendors use to flag a modified canvas.
+  const double amplitude = strength * 0.25;
+
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = data + static_cast<size_t>(y) * stride;
+    for (int x = 0; x < width; ++x) {
+      uint8_t* pixel = row + static_cast<size_t>(x) * 4;
+      for (int channel = 0; channel < 3; ++channel) {  // RGB only
+        int8_t offset = PixelNoiseOffset(key, x, y, channel);
+        double delta = offset * amplitude;
+        int adjusted = static_cast<int>(pixel[channel]) +
+                       static_cast<int>(std::lround(delta));
+        if (adjusted < 0) {
+          adjusted = 0;
+        } else if (adjusted > 255) {
+          adjusted = 255;
+        }
+        pixel[channel] = static_cast<uint8_t>(adjusted);
+      }
+      // The alpha channel is left untouched: a non-255 alpha is a strong
+      // "this canvas was modified" signal.
+    }
+  }
+}
+
+}  // namespace nova
diff --git a/third_party/blink/renderer/core/nova/nova_pixel_noise.h b/third_party/blink/renderer/core/nova/nova_pixel_noise.h
new file mode 100644
index 0000000000..e23bf17f88
--- /dev/null
+++ b/third_party/blink/renderer/core/nova/nova_pixel_noise.h
@@ -0,0 +1,93 @@
+// NOVA Profile Core -- deterministic pixel noise.
+//
+// This is the heart of the graphics impersonation.  Two properties are
+// non-negotiable:
+//
+//  1. **Determinism**: the same profile always produces the same pixels.
+//     The noise is derived from (master_seed, salt, renderer, nudge_step)
+//     through HKDF-SHA256, so a profile that is closed and reopened emits
+//     exactly the same image hash as before.
+//
+//  2. **Separation**: two different profiles never produce the same pixels.
+//     The renderer string is mixed into the hash input, so two different
+//     GPU models cannot accidentally collide.
+//
+// The noise is applied at the Skia readback layer, which is below Blink.
+// That means it covers every path that can observe the pixels:
+//
+//   - CanvasRenderingContext2D.toDataURL() / toBlob()
+//   - CanvasRenderingContext2D.getImageData()
+//   - OffscreenCanvas.convertToBlob()
+//   - WebGLRenderingContext.readPixels()  (including the WebGL2 path)
+//   - ImageBitmap / createImageBitmap round trips
+//
+// and it covers them in *every* execution context, because the renderer
+// process holds one config and the noise key is derived from it rather
+// than from a per-frame counter.
+
+#ifndef NOVA_PROFILE_CORE_PIXEL_NOISE_H_
+#define NOVA_PROFILE_CORE_PIXEL_NOISE_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "nova_core_config.h"
+
+namespace nova {
+
+// A 256-bit key that seeds the pixel noise for one (profile, surface) pair.
+struct PixelNoiseKey {
+  uint8_t bytes[32] = {};
+
+  bool operator==(const PixelNoiseKey& other) const;
+  bool operator!=(const PixelNoiseKey& other) const { return !(*this == other); }
+};
+
+// Derives the noise key for a surface.
+//
+// |surface| names the readback path ("canvas2d", "webgl", "offscreen").
+// Splitting by surface keeps the canvas hash and the WebGL hash
+// independent, so a script that compares the two cannot link them.
+PixelNoiseKey DerivePixelNoiseKey(const SeedConfig& seed,
+                                   const std::string& surface,
+                                   const std::string& salt,
+                                   const std::string& renderer);
+
+// The deterministic double that scales the noise.
+//
+// Mirrors SeedDeriver.derive_webgl_image_value() on the Python side: the
+// value carries at least 17 significant digits so that it survives the
+// round trip through a double and a JSON string without rounding.
+double WebglImageValue(const SeedConfig& seed, const std::string& renderer);
+
+// Applies the noise to a pixel buffer in place.
+//
+// The perturbation is deliberately tiny and *structural* rather than
+// random: the same input buffer always produces the same output buffer,
+// and the magnitude stays inside the tolerance of the anti-bot vendors
+// that compare a canvas render against a reference render.
+//
+// |data|      the pixel bytes (RGBA, 4 bytes per pixel)
+// |stride|    the number of bytes between two consecutive rows
+// |width|     the width in pixels
+// |height|    the height in pixels
+// |key|       the noise key
+// |strength|  0.0 leaves the buffer untouched; 1.0 is the maximum
+//             perturbation
+void ApplyPixelNoise(uint8_t* data,
+                      size_t stride,
+                      int width,
+                      int height,
+                      const PixelNoiseKey& key,
+                      double strength);
+
+// The same perturbation, expressed as an offset for a single pixel.
+//
+// Exposed so that the ANGLE readback path can perturb the value it is
+// about to hand back without copying the whole buffer.
+int8_t PixelNoiseOffset(const PixelNoiseKey& key, int x, int y, int channel);
+
+}  // namespace nova
+
+#endif  // NOVA_PROFILE_CORE_PIXEL_NOISE_H_
diff --git a/third_party/blink/renderer/core/nova/nova_transport.cc b/third_party/blink/renderer/core/nova/nova_transport.cc
new file mode 100644
index 0000000000..cb6bf4a907
--- /dev/null
+++ b/third_party/blink/renderer/core/nova/nova_transport.cc
@@ -0,0 +1,103 @@
+// NOVA Profile Core -- the transport of the profile to the renderer.
+//
+// The reasoning behind this file is in nova_transport.h.
+
+#include "third_party/blink/renderer/core/nova/nova_transport.h"
+
+#include <cstring>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/base64.h"
+#include "third_party/zlib/zlib.h"
+
+namespace nova {
+
+// The marker that says the payload is compressed.
+//
+// The first byte is a NUL, which no JSON document starts with.
+const char kCompressedMarker[] = "\x01nova-z:";
+
+std::string DeflateForCommandLine(std::string_view contents) {
+  std::string out;
+  out.append(kCompressedMarker, sizeof(kCompressedMarker) - 1);
+
+  z_stream stream;
+  std::memset(&stream, 0, sizeof(stream));
+  // The window bits are negative, which asks for a raw deflate stream
+  // without the zlib header and without the trailing checksum.  The
+  // reader below inflates it the same way.
+  if (deflateInit2(&stream, Z_BEST_COMPRESSION, Z_DEFLATED, -MAX_WBITS, 8,
+                   Z_DEFAULT_STRATEGY) != Z_OK) {
+    return std::string();
+  }
+
+  stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(contents.data()));
+  stream.avail_in = static_cast<uInt>(contents.size());
+
+  std::string chunk;
+  chunk.resize(64 * 1024);
+  int status = Z_OK;
+  do {
+    stream.next_out = reinterpret_cast<Bytef*>(chunk.data());
+    stream.avail_out = static_cast<uInt>(chunk.size());
+    status = deflate(&stream, Z_FINISH);
+    if (status != Z_OK && status != Z_STREAM_END && status != Z_BUF_ERROR) {
+      deflateEnd(&stream);
+      return std::string();
+    }
+    out.append(chunk.data(), chunk.size() - stream.avail_out);
+  } while (status != Z_STREAM_END);
+
+  deflateEnd(&stream);
+  return out;
+}
+
+bool InflateFromCommandLine(const std::string& encoded, std::string* out) {
+  const std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(encoded);
+  if (!decoded.has_value()) {
+    return false;
+  }
+  const std::string payload(decoded->begin(), decoded->end());
+  const size_t marker_length = sizeof(kCompressedMarker) - 1;
+  if (payload.size() < marker_length ||
+      payload.compare(0, marker_length, kCompressedMarker) != 0) {
+    // Not compressed: the payload is the document itself.
+    *out = payload;
+    return true;
+  }
+
+  const char* data = payload.data() + marker_length;
+  size_t size = payload.size() - marker_length;
+
+  z_stream stream;
+  std::memset(&stream, 0, sizeof(stream));
+  if (inflateInit2(&stream, -MAX_WBITS) != Z_OK) {
+    return false;
+  }
+  stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(data));
+  stream.avail_in = static_cast<uInt>(size);
+
+  std::string result;
+  std::string chunk;
+  chunk.resize(64 * 1024);
+  int status = Z_OK;
+  do {
+    stream.next_out = reinterpret_cast<Bytef*>(chunk.data());
+    stream.avail_out = static_cast<uInt>(chunk.size());
+    status = inflate(&stream, Z_NO_FLUSH);
+    if (status != Z_OK && status != Z_STREAM_END) {
+      inflateEnd(&stream);
+      return false;
+    }
+    result.append(chunk.data(), chunk.size() - stream.avail_out);
+  } while (status != Z_STREAM_END && stream.avail_in > 0);
+
+  inflateEnd(&stream);
+  *out = result;
+  return true;
+}
+
+}  // namespace nova
diff --git a/third_party/blink/renderer/core/nova/nova_transport.h b/third_party/blink/renderer/core/nova/nova_transport.h
new file mode 100644
index 0000000000..5ca40337fa
--- /dev/null
+++ b/third_party/blink/renderer/core/nova/nova_transport.h
@@ -0,0 +1,66 @@
+// NOVA Profile Core -- the transport of the profile to the renderer.
+//
+// The browser process reads the profile from disk and the renderer has
+// to have it.  The renderer cannot read the file itself: it is
+// sandboxed and the user data directory is not among the paths it may
+// open.  The browser is not sandboxed, so it reads the file and hands
+// the document over.
+//
+// The hand-over rides on the renderer's command line.  A Windows
+// command line is a single string that the system splits into
+// arguments, and its quoting rules cannot describe a document that
+// itself contains quotes, spaces and newlines: the renderer would
+// receive a fragment of the JSON, fail to parse it, and fall back to
+// the host's values -- which is the one thing the engine exists to
+// prevent.
+//
+// Base64 fixes the quoting.  It has no spaces, no quotes and no
+// newlines, so the argument survives the trip intact.
+//
+// It does not fix the length.  A Windows command line holds at most
+// 32,767 characters, and the renderer is started with the profile *and*
+// the JavaScript layer's payload on its command line.  Base64 of the
+// two together is more than that.
+//
+// So both documents are deflated before they are encoded.  The profile
+// is eighteen kilobytes of JSON and the payload is nine; deflated they
+// are three and two, and base64 of that is seven in all.
+//
+// The marker at the front of the payload says whether it is
+// compressed.  A reader that meets the marker inflates it; a reader
+// that does not takes the payload as it stands.  That way a browser
+// that was built before the compression was added still reads a payload
+// that was written after it.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_NOVA_NOVA_TRANSPORT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_NOVA_NOVA_TRANSPORT_H_
+
+#include <string>
+#include <string_view>
+
+namespace nova {
+
+// The marker that says the payload is compressed.
+//
+// The payload starts with it, and a reader that finds it inflates what
+// follows.  The marker holds a NUL as its first byte, which no JSON
+// document starts with, so a plain document can never be mistaken for a
+// compressed one.
+extern const char kCompressedMarker[];
+
+// Deflates ``contents`` for the command line.
+//
+// The result carries the marker, so the reader knows what to do with
+// it.  An empty result means the compression failed, and the caller
+// should then fall back to another transport.
+std::string DeflateForCommandLine(std::string_view contents);
+
+// The inverse of DeflateForCommandLine.
+//
+// ``encoded`` is the base64 of the deflated document.  It returns false
+// when the argument is not valid base64.
+bool InflateFromCommandLine(const std::string& encoded, std::string* out);
+
+}  // namespace nova
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_NOVA_NOVA_TRANSPORT_H_
diff --git a/third_party/blink/renderer/core/nova/nova_unit_values.cc b/third_party/blink/renderer/core/nova/nova_unit_values.cc
new file mode 100644
index 0000000000..e1f31e5ed1
--- /dev/null
+++ b/third_party/blink/renderer/core/nova/nova_unit_values.cc
@@ -0,0 +1,438 @@
+// NOVA Profile Core -- the per-unit values, derived in the core.
+//
+// The profile file carries the *family* of a device: the model, the
+// graphics part, the panel, the browser major.  Those are shared by
+// every unit of the family, exactly as they are shared by every handset
+// of that model in a shop.
+//
+// The values that a site uses to tell two *people* apart are not in
+// that family.  The core count, the amount of memory, the number of
+// touch points -- these are the readings that differ between two units
+// that came out of the same factory, and they are what a script reads
+// when it wants to know whether it is talking to a hundred thousand
+// different handsets or to one handset wearing a hundred thousand
+// hats.
+//
+// **Who decides the value**
+//
+// The control plane decides.  It draws the value from the profile's own
+// seed, *stratified*, so that two units of one family never draw the
+// same one; the stratum is what separates the units of a family, and
+// it travels with the seed so that a profile that is closed and
+// reopened comes back as the same unit.
+//
+// The core is the *authority*, not a second drawer.  It reads the
+// value the control plane drew and serves it unchanged.  Two reasons:
+//
+//   1. The two sides have to agree.  The probe reads the browser and
+//      compares the answer against what the control plane believes; a
+//      core that drew its own value would disagree with the control
+//      plane on every profile, and the report would say the whole
+//      engine is broken.
+//
+//   2. The stratification has to be *total*.  The control plane knows
+//      how many units a family carries, and it hands each of them its
+//      own slice of the choice space.  The core sees one unit at a
+//      time and cannot know how many there are, so a core that drew
+//      independently would sometimes land on a value another unit
+//      already has.
+//
+// The core does draw, in exactly one case: when the profile leaves a
+// value out.  A profile that says nothing about its core count gets
+// one from the hardware range, drawn from the seed the same way the
+// control plane would have drawn it -- and the draw is the control
+// plane's *algorithm*, reproduced here, so that the two sides answer
+// the same question with the same number.
+//
+// **The algorithm**
+//
+// The draw is the control plane's ``derive_int``: a rejection-sampled
+// uniform integer over the range, taken from an HKDF expansion whose
+// ``info`` string carries the axis, the epoch, the nudge step, the
+// stratum and the context.  The salt is the navigator's own salt, so
+// the unit readings live on the navigator's axis -- which is where the
+// control plane draws the values it does draw.
+//
+// Two axes never correlate, because the context is part of the info
+// string: a fleet cannot be found out because the units that report
+// eight cores are exactly the units that report four gigabytes.
+
+#include "nova_unit_values.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "third_party/boringssl/src/include/openssl/digest.h"
+#include "third_party/boringssl/src/include/openssl/hmac.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace nova {
+namespace {
+
+constexpr size_t kHashLen = 32;
+
+// The domain salt of the unit axis.
+//
+// It is the navigator's own salt, and it has to be: the control plane
+// draws the core count and the memory on the navigator axis, and the
+// core has to draw the same value from the same salt when the profile
+// leaves the value out.  A separate salt would make the two sides
+// disagree the moment the profile was incomplete.
+const char kUnitDomainSalt[] = "nova/v1/navigator";
+
+std::vector<uint8_t> HmacSha256(const uint8_t* key,
+                                size_t key_len,
+                                const uint8_t* data,
+                                size_t data_len) {
+  unsigned char result[kHashLen];
+  unsigned int result_len = 0;
+  HMAC(EVP_sha256(), key, static_cast<int>(key_len), data, data_len, result,
+       &result_len);
+  return std::vector<uint8_t>(result, result + result_len);
+}
+
+std::vector<uint8_t> HkdfExtract(const std::vector<uint8_t>& salt,
+                                  const std::vector<uint8_t>& ikm) {
+  std::vector<uint8_t> effective_salt = salt;
+  if (effective_salt.empty()) {
+    effective_salt.assign(kHashLen, 0);
+  }
+  return HmacSha256(effective_salt.data(), effective_salt.size(), ikm.data(),
+                    ikm.size());
+}
+
+std::vector<uint8_t> HkdfExpand(const std::vector<uint8_t>& prk,
+                                 const std::string& info,
+                                 size_t length) {
+  std::vector<uint8_t> okm;
+  okm.reserve(length);
+  std::vector<uint8_t> block;
+  uint8_t counter = 1;
+  while (okm.size() < length) {
+    std::vector<uint8_t> input;
+    input.insert(input.end(), block.begin(), block.end());
+    input.insert(input.end(), info.begin(), info.end());
+    input.push_back(counter);
+    block = HmacSha256(prk.data(), prk.size(), input.data(), input.size());
+    okm.insert(okm.end(), block.begin(), block.end());
+    ++counter;
+  }
+  okm.resize(length);
+  return okm;
+}
+
+bool HexToBytes(const std::string& hex, uint8_t* out, size_t out_len) {
+  if (hex.size() != out_len * 2) {
+    return false;
+  }
+  auto nibble = [](char c) -> int {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+  };
+  for (size_t i = 0; i < out_len; ++i) {
+    int hi = nibble(hex[i * 2]);
+    int lo = nibble(hex[i * 2 + 1]);
+    if (hi < 0 || lo < 0) {
+      return false;
+    }
+    out[i] = static_cast<uint8_t>((hi << 4) | lo);
+  }
+  return true;
+}
+
+// The seed of a profile.
+//
+// The stratum is what separates two units of the *same* family, so it
+// is folded into the derivation: without it, two units of one model
+// would draw the same values.
+struct UnitSeed {
+  uint8_t master[32] = {};
+  uint32_t epoch = 0;
+  uint32_t stratum = 0;
+  bool has_stratum = false;
+  uint32_t nudge = 0;
+  bool valid = false;
+};
+
+UnitSeed SeedOf(const SeedConfig& seed) {
+  UnitSeed out;
+  out.valid = HexToBytes(seed.master_seed, out.master, sizeof(out.master));
+  out.epoch = seed.seed_epoch;
+  out.stratum = seed.stratum;
+  out.has_stratum = seed.has_stratum;
+  out.nudge = seed.nudge_step;
+  return out;
+}
+
+// The draw.
+//
+// It is the control plane's ``derive_int``: a uniform integer over the
+// inclusive range, drawn by rejection sampling from an HKDF expansion.
+//
+// The rejection sampling is what makes the distribution exactly
+// uniform.  A plain modulo would bias the low end of the range, and
+// the low end of the range is where the narrow readings live: a fleet
+// that reported more six-core handsets than the hardware of the model
+// could account for would be a fleet a site could contradict.
+//
+// The draw counter is part of the context, so two calls with the same
+// context return two different numbers -- which is what the control
+// plane does, and what keeps the core from answering the same value
+// twice for two different axes that share a context.
+uint64_t DrawRaw(const UnitSeed& seed,
+                 const std::string& context,
+                 size_t length) {
+  if (!seed.valid) {
+    return 0;
+  }
+  std::vector<uint8_t> ikm(seed.master, seed.master + sizeof(seed.master));
+  std::vector<uint8_t> salt(kUnitDomainSalt,
+                             kUnitDomainSalt + sizeof(kUnitDomainSalt));
+  std::vector<uint8_t> prk = HkdfExtract(salt, ikm);
+
+  std::string info = "navigator";
+  info += "|epoch=" + std::to_string(seed.epoch);
+  info += "|nudge=" + std::to_string(seed.nudge);
+  if (seed.has_stratum) {
+    info += "|stratum=" + std::to_string(seed.stratum);
+  }
+  info += "|";
+  info += context;
+
+  std::vector<uint8_t> okm = HkdfExpand(prk, info, length);
+  uint64_t value = 0;
+  for (size_t i = 0; i < length && i < 8; ++i) {
+    value = (value << 8) | okm[i];
+  }
+  return value;
+}
+
+// A uniform integer over the inclusive range [low, high].
+//
+// The counter is the draw counter of the control plane: it starts at
+// zero and advances with every draw of the same context.
+int DrawInt(const UnitSeed& seed,
+            const std::string& context,
+            int low,
+            int high,
+            uint32_t* counter) {
+  if (low > high) {
+    return low;
+  }
+  const uint64_t span = static_cast<uint64_t>(high - low) + 1;
+  if (span == 1) {
+    return low;
+  }
+  // The number of bytes the range needs, and the limit below which a
+  // draw is accepted -- the largest multiple of the span that fits in
+  // the byte count.
+  size_t n_bytes = 1;
+  while ((1ULL << (n_bytes * 8)) < span) {
+    ++n_bytes;
+  }
+  const uint64_t ceiling = 1ULL << (n_bytes * 8);
+  const uint64_t limit = ceiling - (ceiling % span);
+
+  uint32_t attempt = *counter;
+  uint32_t retry = 0;
+  while (true) {
+    std::string attempt_context = context;
+    attempt_context += "|draw=" + std::to_string(attempt);
+    attempt_context += "|retry=" + std::to_string(retry);
+    const uint64_t value = DrawRaw(seed, attempt_context, n_bytes);
+    if (value < limit) {
+      *counter = attempt + 1;
+      return low + static_cast<int>(value % span);
+    }
+    ++retry;
+    ++attempt;
+  }
+}
+
+// A uniform index into a list of options.
+//
+// The control plane draws an *index* into the option list, not a
+// number out of a range: the two are the same only when the list is
+// contiguous, and it is not always -- a model's memory options are
+// four and eight, so a range of four to eight has five members and the
+// list has two.  The draw therefore has to be the index, or the two
+// sides would answer different questions.
+int DrawIndex(const UnitSeed& seed,
+              const std::string& context,
+              size_t count,
+              uint32_t* counter) {
+  if (count == 0) {
+    return 0;
+  }
+  return DrawInt(seed, context, 0, static_cast<int>(count) - 1, counter);
+}
+
+// The memory the platform reports.
+//
+// The platform clamps the value to a power of two and to eight
+// gigabytes, because that is what ``navigator.deviceMemory`` can
+// return.  A value outside that set is a tell on its own.
+int QuantizeMemory(int gigabytes) {
+  int value = gigabytes;
+  if (value < 1) {
+    value = 1;
+  }
+  if (value > 8) {
+    value = 8;
+  }
+  // Round down to a power of two.
+  int power = 1;
+  while (power * 2 <= value) {
+    power *= 2;
+  }
+  return power;
+}
+
+}  // namespace
+
+UnitValues DeriveUnitValues(const ProfileConfig& config,
+                             const std::vector<int>& preset_cores,
+                             const std::vector<int>& preset_memory,
+                             const std::vector<int>& preset_touch,
+                             int preset_width,
+                             int preset_height,
+                             double preset_pixel_ratio,
+                             const std::vector<double>& preset_ratios) {
+  UnitValues values;
+  const SeedConfig& seed = config.seed_config;
+  const UnitSeed unit_seed = SeedOf(seed);
+
+  // The draw counters of the control plane.  They are per context, and
+  // the contexts below are the ones the control plane uses.
+  uint32_t counter_cores = 0;
+  uint32_t counter_memory = 0;
+  uint32_t counter_touch = 0;
+
+  bool derived = false;
+
+  // -- the core count ------------------------------------------------------
+  //
+  // The value the control plane drew wins.  It is the one that is
+  // stratified, and it is the one the probe compares against.
+  if (config.navigator.hardware_concurrency > 0) {
+    values.hardware_concurrency = config.navigator.hardware_concurrency;
+  } else if (!preset_cores.empty()) {
+    const int index = DrawIndex(unit_seed, "cores", preset_cores.size(), &counter_cores);
+    values.hardware_concurrency = preset_cores[index];
+    derived = true;
+  } else {
+    values.hardware_concurrency = 8;
+    derived = true;
+  }
+
+  // -- the memory ----------------------------------------------------------
+  if (config.navigator.device_memory > 0) {
+    values.device_memory = config.navigator.device_memory;
+  } else if (!preset_memory.empty()) {
+    const int index = DrawIndex(unit_seed, "memory", preset_memory.size(), &counter_memory);
+    values.device_memory = QuantizeMemory(preset_memory[index]);
+    derived = true;
+  } else {
+    values.device_memory = 8;
+    derived = true;
+  }
+
+  // -- the touch points ----------------------------------------------------
+  //
+  // The digitiser of the model decides the number of contacts.  Two
+  // units of one model share a digitiser *class*, but a model that
+  // shipped with both a five-point and a ten-point panel exists, and
+  // the site reads the number.
+  if (config.navigator.max_touch_points > 0) {
+    values.max_touch_points = config.navigator.max_touch_points;
+  } else if (!preset_touch.empty()) {
+    const int index = DrawIndex(unit_seed, "touch", preset_touch.size(), &counter_touch);
+    values.max_touch_points = preset_touch[index];
+    derived = true;
+  } else {
+    values.max_touch_points = 5;
+    derived = true;
+  }
+
+  // -- the panel ------------------------------------------------------------
+  //
+  // The resolution is a property of the *panel*, so it is not free: the
+  // unit's panel is within a couple of pixels of the family's panel.
+  // The jitter is what separates two units of the same model, and it is
+  // tiny enough that the two cannot be told apart by eye.
+  if (config.screen.width > 0 && config.screen.height > 0) {
+    values.screen_width = config.screen.width;
+    values.screen_height = config.screen.height;
+  } else if (preset_width > 0 && preset_height > 0) {
+    uint32_t counter_panel = 0;
+    const int jitter_x = DrawInt(unit_seed, "panel_x", -2, 2, &counter_panel);
+    const int jitter_y = DrawInt(unit_seed, "panel_y", -2, 2, &counter_panel);
+    values.screen_width = std::max(1, preset_width + jitter_x);
+    values.screen_height = std::max(1, preset_height + jitter_y);
+    derived = true;
+  } else {
+    values.screen_width = 1080;
+    values.screen_height = 2400;
+    derived = true;
+  }
+
+  // -- the pixel ratio -----------------------------------------------------
+  //
+  // The ratio is a property of the panel and of the display scaling the
+  // owner chose, so it is drawn from the small set the hardware can
+  // produce -- the set the *model* offers, not a set of its own.
+  //
+  // A fixed list would be a list of ratios some other device offers,
+  // and a model whose panels are all 2.625 that reports 3.5 is a
+  // model with a panel it does not have.
+  if (config.screen.device_pixel_ratio > 0) {
+    values.device_pixel_ratio = config.screen.device_pixel_ratio;
+  } else if (!preset_ratios.empty()) {
+    uint32_t counter_ratio = 0;
+    const int index = DrawIndex(unit_seed, "ratio", preset_ratios.size(),
+                                &counter_ratio);
+    values.device_pixel_ratio = preset_ratios[index];
+    derived = true;
+  } else if (preset_pixel_ratio > 0) {
+    values.device_pixel_ratio = preset_pixel_ratio;
+    derived = true;
+  } else {
+    values.device_pixel_ratio = 3.0;
+    derived = true;
+  }
+
+  values.derived = derived;
+  return values;
+}
+
+std::string UnitValuesSignature(const UnitValues& values) {
+  std::string material;
+  material += "cores=" + std::to_string(values.hardware_concurrency);
+  material += "|mem=" + std::to_string(values.device_memory);
+  material += "|touch=" + std::to_string(values.max_touch_points);
+  material += "|screen=" + std::to_string(values.screen_width) + "x" +
+              std::to_string(values.screen_height);
+  material += "|dpr=" + std::to_string(values.device_pixel_ratio);
+
+  uint8_t digest[SHA256_DIGEST_LENGTH];
+  SHA256_CTX sha_ctx;
+  SHA256_Init(&sha_ctx);
+  SHA256_Update(&sha_ctx, material.data(), material.size());
+  SHA256_Final(digest, &sha_ctx);
+
+  static const char kHex[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(sizeof(digest) * 2);
+  for (size_t i = 0; i < sizeof(digest); ++i) {
+    out.push_back(kHex[digest[i] >> 4]);
+    out.push_back(kHex[digest[i] & 0x0f]);
+  }
+  return out;
+}
+
+}  // namespace nova
