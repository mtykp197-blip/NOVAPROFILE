# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
dist_test/
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# The dataset probe workspace.
#
# This holds the raw scraped datasets -- 33 MB of CSV -- and the scratch
# scripts used to merge them.  The merged result is committed under
# novaprofile/core_patch/data/; the raw dumps are not, because they are
# reproducible from the public sources and they bloat the repository.
.dataset_probe/

# The scratch directory the browser verification writes into.
#
# A Chromium profile directory holds the component cache, which reaches
# a hundred megabytes and over the size GitHub accepts.  Nothing in here
# is worth keeping: the directory is recreated on every run.
_cfgtest/
_probe*.json

# Nova runtime
state.db
state.db-wal
state.db-shm
keys/
logs/
profiles/
*.db-journal
.nova_verify*/
.nova_run/
*.nova

# Test and measurement scratch output
*.log
*.log.err
!scale_check_100m.log
.nova_measurements.tmp/
scratch/
tmp/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Local interpreter pointer (machine specific)
.python_path

# The chat-transfer export holds the Cursor account credentials.
# It travels by hand (USB, drive), never through the repository.
*CHAT_TRANSFER*/
*chat_transfer*/
