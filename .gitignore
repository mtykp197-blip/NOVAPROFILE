# The desktop shell's dependencies.
#
# The dependencies are restored from ``package-lock.json`` by ``npm
# install``; they are not part of the source and they are large.
node_modules/
novaprofile/desktop/node_modules/
novaprofile/desktop/tools/
novaprofile/desktop/renderer/

# The packaged application, as it stands on the disk.
novaprofile/_internal/
novaprofile/NOVAPROFILE.exe
novaprofile/*.dll

# The build output of the shell.
novaprofile/desktop/dist/
novaprofile/desktop/dist-new/

# The frozen control plane.
novaprofile/control_plane/build/
novaprofile/control_plane/dist/

# A backup of the patch series, taken before it was regenerated.
novaprofile/core_patch/patches.bak/

# The working notes of the audit.
.audit/

# The scratch directories the probes and the test runs leave behind.
.pytest-tmp/
.pytest-tmp*/
.pytest_tmp/
.pytest_tmp*/
**/.pytest_tmp*/
.tmp_probe_data/
.dataset_probe/

# The Python bytecode.  It is regenerated from the source on every run.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# The shell that the packaged desktop app replaced.  It is kept here
# for reference, but it is not the source of the product any more.
desktop-app/

# Where the installer puts the application.  It is a copy of the
# build, not the build.
installed/

# The built core.  The core is a *build artifact* of the patch series
# under ``novaprofile/core_patch``: it is rebuilt from the series by
# ``novaprofile/core_patch/build.py`` against a Chromium checkout, and
# it is far too large to keep in the repository.
#
# The leading slash matters: without it the pattern would match every
# directory called "core" at any depth, and the engine's own package
# ``novaprofile/control_plane/novaprofile/core/`` is source code that
# has to be in the repository.
/core/

# The build and run logs of the sessions.  They are the scratch notes
# of whoever was working on it, not a part of the product.
*.log
*.log.err
build_log*.txt

# The wheels that were fetched by hand to satisfy a dependency.
*.whl

# The scratch files of the probes.
.spread_*.json
.ids.txt
.python_path
